# Maintainer: token419 <https://github.com/token419>
pkgname=llama-dbusd
pkgver=0.1.4
pkgrel=1
pkgdesc="Rust D-Bus daemon for llama.cpp orchestration"
arch=('x86_64' 'aarch64')
url="https://github.com/token419/llama-dbusd"
license=('MIT')
depends=('dbus')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('8dd726fdc97492e51d951c321575e6af70b12f3e6a4ca4c6f47a1862328afd90')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  CFLAGS+=" -ffat-lto-objects"
  export CFLAGS LDFLAGS
  cargo build --frozen --release --all-features
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$pkgname.service" "$pkgdir/usr/lib/systemd/user/$pkgname.service"
  sed -i 's|%h/.local/bin/llama-dbusd|/usr/bin/llama-dbusd|' "$pkgdir/usr/lib/systemd/user/$pkgname.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
